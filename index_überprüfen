        function getCalculatedOrderPrice(basePrice, stammkundeFlag, codeDiscountPercent) {
            const stammDiscount = stammkundeFlag ? 0.05 : 0;
            const totalDiscount = Math.min(1, stammDiscount + codeDiscountPercent);
            return Number((basePrice * (1 - totalDiscount)).toFixed(2));
        }

        function updatePackageInputDisplay() {
            const finalPrice = getCalculatedOrderPrice(selectedPackagePrice, isStammkundeActive, appliedDiscountPercent);
            document.getElementById('selectedPackageInput').value = `${selectedPackageName} (${finalPrice.toFixed(0)} €)`;
