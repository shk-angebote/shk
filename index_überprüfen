        function exportFileCheckToPDF() {
            if (!directFileCheckItems || directFileCheckItems.length === 0) {
                alert("Keine Positionen in der Prüfliste vorhanden.");
                return;
            }
            if (!window.jspdf || !window.jspdf.jsPDF) {
                alert("jsPDF nicht geladen.");
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
            const fmt = (n) => Number(n || 0).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            let totalOfferNet = 0, totalRefNet = 0;
            directFileCheckItems.forEach(it => {
                totalOfferNet += (it.qty * it.offeredUnitPrice);
                if (it.refUnitPrice > 0) totalRefNet += (it.qty * it.refUnitPrice);
            });

            const diffNet = totalOfferNet - totalRefNet;
            const diffPct = totalRefNet > 0 ? (((totalOfferNet - totalRefNet) / totalRefNet) * 100) : 0;
            const todayStr = new Date().toLocaleDateString('de-DE');

            doc.setFont('helvetica', 'bold');
            doc.setFontSize(16);
            doc.setTextColor(16, 185, 129);
            doc.text('SHK Prüfprotokoll — GAEB & PDF Abgleich', 14, 18);

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(9);
            doc.setTextColor(100, 116, 139);
            doc.text(`Datum: ${todayStr}   |   Positionen: ${directFileCheckItems.length}`, 14, 24);

            doc.setFillColor(241, 245, 249);
            doc.roundedRect(14, 29, 182, 20, 2, 2, 'F');
            doc.setFontSize(8);
            doc.setTextColor(71, 85, 105);
            doc.text('ANGEBOTSSUMME', 18, 35);
            doc.text('REFERENZSUMME (DB-Ø)', 80, 35);
            doc.text('GESAMTABWEICHUNG', 144, 35);

            doc.setFont('helvetica', 'bold');
            doc.setFontSize(10);
            doc.setTextColor(15, 23, 42);
            doc.text(`${fmt(totalOfferNet)} €`, 18, 41);
            doc.setTextColor(5, 150, 105);
            doc.text(`${fmt(totalRefNet)} €`, 80, 41);
            doc.setTextColor(diffNet > 0 ? 225 : 5, diffNet > 0 ? 29 : 150, diffNet > 0 ? 72 : 105);
            doc.text(`${fmt(diffNet)} € (${diffPct.toFixed(1)} %)`, 144, 41);

            let y = 55;
            const drawHeader = (yPos) => {
                doc.setFillColor(15, 23, 42);
                doc.rect(14, yPos, 182, 8, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(8);
                doc.setTextColor(255, 255, 255);
                doc.text('Pos.', 16, yPos + 5.3);
                doc.text('Position / Beschreibung', 26, yPos + 5.3);
                doc.text('Menge', 108, yPos + 5.3);
                doc.text('Angebot EP', 126, yPos + 5.3);
                doc.text('DB-Ø EP', 148, yPos + 5.3);
                doc.text('Abw.', 168, yPos + 5.3);
                doc.text('Diff. Gesamt', 180, yPos + 5.3);
                return yPos + 8;
            };

            y = drawHeader(y);

            directFileCheckItems.forEach((it, idx) => {
                if (y > 275) { doc.addPage(); y = 18; y = drawHeader(y); }
                const hasRef = it.refUnitPrice > 0;
                const devPct = hasRef ? (((it.offeredUnitPrice - it.refUnitPrice) / it.refUnitPrice) * 100) : null;
                const rowDiff = hasRef ? ((it.offeredUnitPrice - it.refUnitPrice) * it.qty) : 0;

                if (!hasRef) doc.setFillColor(224, 242, 254);
                else if (devPct <= 0) doc.setFillColor(209, 250, 229);
                else if (devPct <= 20) doc.setFillColor(254, 243, 199);
                else doc.setFillColor(255, 228, 230);

                doc.rect(14, y, 182, 8, 'F');
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(8);
                doc.setTextColor(15, 23, 42);

                doc.text(String(idx + 1), 16, y + 5.2);
                doc.text(String(it.title || '').substring(0, 46), 26, y + 5.2);
                doc.text(`${it.qty} ${it.unit}`, 108, y + 5.2);
                doc.text(`${fmt(it.offeredUnitPrice)} €`, 126, y + 5.2);
                doc.text(hasRef ? `${fmt(it.refUnitPrice)} €` : '0,00 €', 148, y + 5.2);

                doc.setFont('helvetica', 'bold');
                if (!hasRef) {
                    doc.setTextColor(2, 132, 199);
                    doc.text('manuell', 168, y + 5.2);
                    doc.text('-', 180, y + 5.2);
                } else {
                    doc.setTextColor(devPct <= 0 ? 5 : (devPct <= 20 ? 180 : 225), devPct <= 0 ? 150 : (devPct <= 20 ? 83 : 29), devPct <= 0 ? 105 : (devPct <= 20 ? 9 : 72));
                    doc.text(`${devPct > 0 ? '+' : ''}${devPct.toFixed(1)}%`, 168, y + 5.2);
                    doc.text(`${rowDiff > 0 ? '+' : ''}${Math.round(rowDiff)} €`, 180, y + 5.2);
                }
                y += 8.5;
            });

            doc.save(`SHK_Pruefprotokoll_${todayStr.replace(/\./g, '-')}.pdf`);
        }

