        async function handlePortalOrderSubmission(event) {
            event.preventDefault();
            if (!currentUser) return;
            const file = document.getElementById('portalOfferFile').files[0];
            if (!file) { alert("Bitte Datei auswählen."); return; }

            const selectVal = document.getElementById('portalPackageSelect').value || 'Heizungs-Angebot|149';
            const [pkgName, priceStr] = selectVal.split('|');
            const basePrice = parseFloat(priceStr) || 149;
            const projectName = (document.getElementById('portalProjectInput').value || '').trim() || 'Allgemein';
            const notes = (document.getElementById('portalOrderNotes').value || '').trim();
            const code = (document.getElementById('portalDiscountInput').value || '').trim().toUpperCase();
            const codeDisc = (code === 'ANGEBOT10') ? 0.10 : 0;

            try {
                const updatedRole = await checkAndAutoUpgradeStammkunde(currentUser.email, 1);
                const customerIsStammkunde = (updatedRole === 'Stammkunde');
                isStammkundeActive = customerIsStammkunde;
                currentUserRole = updatedRole;
                updateNavbarUI();

                const isFirstInquiry = (userOrders.length === 0);
                const finalPrice = getCalculatedOrderPrice(basePrice, customerIsStammkunde, codeDisc);
                let fName = '', lName = '';
                const sampleO = userOrders.find(o => o.firstName || o.lastName);
                if (sampleO) { fName = sampleO.firstName || ''; lName = sampleO.lastName || ''; }

                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = async function() {
                    const orderId = 'SHK-' + Math.floor(100000 + Math.random() * 900000);
                    const newOrder = {
                        id: orderId, packageName: pkgName, projectName: projectName, price: finalPrice, originalPrice: basePrice, discountApplied: customerIsStammkunde ? 'Stammkunde (5%)' : null, email: currentUser.email, firstName: fName, lastName: lName, notes: notes, fileName: file.name, fileData: reader.result, additionalFiles: [], status: 1, paymentStatus: 'unpaid', isFirstInquiry: isFirstInquiry, depositInvoiceSent: false, isArchived: false, hiddenByClient: false, pendingAction: null, createdAt: new Date().toISOString(), userId: currentUser.uid
                    };
                    if (db) await db.collection('orders').add(newOrder);
                    document.getElementById('portalNewOrderForm').reset();
                    closeClientNewOrderModal();
                    await loadUserOrders();
                    selectClientOrder(orderId);
                    alert(`Auftrag ${orderId} erfolgreich angelegt!`);
                };
            } catch (err) {
                alert("Fehler: " + err.message);
            }
        }

