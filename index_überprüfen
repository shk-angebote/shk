            document.getElementById('adminEditorPanel').classList.add('hidden');
            document.getElementById('adminMarketPricesPanel').classList.add('hidden');
            document.getElementById('adminCustomersPanel').classList.add('hidden');
            document.getElementById('adminReconstructPanel').classList.add('hidden');
            document.getElementById('adminFileCheckPanel').classList.add('hidden');
            document.getElementById('adminSearchContainer').classList.add('hidden');

            if (tabName === 'marketprices') {
                document.getElementById('adminMarketPricesPanel').classList.remove('hidden');
                document.getElementById('adminSearchContainer').classList.remove('hidden');
                loadMarketPrices();
            } else if (tabName === 'reconstruct') {
                document.getElementById('adminReconstructPanel').classList.remove('hidden');
                document.getElementById('adminSearchContainer').classList.remove('hidden');
                populateReconstructTargetOrderDropdown();
                loadMarketPrices();
                renderReconstructCatalogList();
                renderReconstructedOffer();
            } else if (tabName === 'filecheck') {
                document.getElementById('adminFileCheckPanel').classList.remove('hidden');
                populateFileCheckTargetOrderDropdown();
                loadMarketPrices();
                renderDirectFileCheckTable();
            } else if (tabName === 'customers') {
                document.getElementById('adminCustomersPanel').classList.remove('hidden');
                loadCustomers();
            } else {
                if (!selectedAdminOrderId) {
                    document.getElementById('adminSelectPrompt').classList.remove('hidden');
                } else {
                    document.getElementById('adminEditorPanel').classList.remove('hidden');
                }
            }
            renderAdminDashboard();
        }

        function renderAdminDashboard() {
            let currentRevenue = 0, openRevenue = 0;
            adminOrders.forEach(o => {
                if (o.status == 5 || o.status == 6) return;
                const p = o.price || 149;
                if (o.paymentStatus === 'paid') currentRevenue += p;
                else openRevenue += p;
            });
            document.getElementById('adminStatCurrentRevenue').textContent = currentRevenue + ' €';
            document.getElementById('adminStatOpenRevenue').textContent = openRevenue + ' €';

            const container = document.getElementById('adminOrdersList');
            const listTitle = document.getElementById('adminListTitle');
            if (!container) return;

            if (currentAdminTab === 'active') {
                listTitle.textContent = "Aktive Aufträge";
                const active = adminOrders.filter(o => !o.isArchived && o.status != 5 && o.status != 6);
                container.innerHTML = active.length === 0 ? `<p class="text-xs text-slate-500">Keine Aufträge.</p>` : active.map(o => renderOrderCard(o)).join('');
            } else if (currentAdminTab === 'approvals') {
                listTitle.textContent = "Offene Freigaben";
                const pending = adminOrders.filter(o => !o.isArchived && (o.pendingAction === 'reject' || o.pendingAction === 'cancel'));
                container.innerHTML = pending.length === 0 ? `<p class="text-xs text-slate-500">Keine Freigaben.</p>` : pending.map(o => renderOrderCard(o)).join('');
            } else if (currentAdminTab === 'customers') {
                listTitle.textContent = "Kunden & Ränge";
            }
        }

        function selectAdminOrder(orderId) {
            if (['marketprices', 'customers', 'reconstruct', 'filecheck'].includes(currentAdminTab)) return;
            selectedAdminOrderId = orderId;
            const order = adminOrders.find(o => o.id === orderId);
            if (!order) return;
            document.getElementById('adminSelectPrompt').classList.add('hidden');
            document.getElementById('adminEditorPanel').classList.remove('hidden');
            document.getElementById('adminEditOrderId').textContent = `Auftrag ${order.id}`;
            document.getElementById('adminEditCustomerEmail').textContent = order.email;
        }

        async function saveAdminOrderChanges() {
            if (!selectedAdminOrderId) return;
            const order = adminOrders.find(o => o.id === selectedAdminOrderId);
            if (!order || !order.idDoc) return;
            order.status = parseInt(document.getElementById('adminStatusSelect').value);
            order.summary = document.getElementById('adminSummaryInput').value;
            order.defects = document.getElementById('adminDefectsInput').value.split('\n').filter(Boolean);
            if (db) {
                await db.collection('orders').doc(order.idDoc).update({ status: order.status, summary: order.summary, defects: order.defects });
                alert('Gespeichert!');
            }
        }

        async function handleAuthSubmit(event) {
            event.preventDefault();
            const rawInput = document.getElementById('authEmail').value.trim();
            const password = document.getElementById('authPassword').value;

            if (!isForgotPasswordMode && !isRegisterMode && rawInput.toLowerCase() === DEMO_IDENTIFIER && password === 'Demo') {
                sessionStorage.setItem('shk_demo_session', 'true');
                currentUser = { email: 'Demo', uid: 'demo_admin_uid' };
                await ensureCustomerRecord('Demo', 'Demo', 'Admin-Konto', 'Admin');
                currentUserRole = await fetchRoleForEmail('Demo');
                updateNavbarUI();
                closeAuthModal();
                await loadAdminOrders();
                await loadMarketPrices();
                await loadCustomers();
                openAdminPortal();
                return;
            }

            try {
                sessionStorage.removeItem('shk_demo_session');
                await auth.signInWithEmailAndPassword(rawInput, password);
                closeAuthModal();
                openClientPortal();
            } catch (error) {
                alert('Fehler: ' + error.message);
            }
        }

        async function logoutUser() {
            sessionStorage.removeItem('shk_demo_session');
            if (auth && auth.currentUser) await auth.signOut();
            currentUser = null;
            currentUserRole = 'Kunde';
            updateNavbarUI();
            switchView('landing');
        }
    </script>
</body>
</html>
