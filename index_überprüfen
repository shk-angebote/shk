        function isMainAdminEmail(email) {
            if (!email) return false;
            return email.toLowerCase().trim() === ADMIN_EMAIL.toLowerCase().trim();
        }

        function isMainAdminUser() {
            return currentUser && isMainAdminEmail(currentUser.email) && currentUserRole === 'Hauptadmin';
        }

        function hasAdminAccess(role = currentUserRole) {
            return ['Hauptadmin', 'Admin', 'Sachbearbeiter'].includes(role);
        }

        function canManageRoles(role = currentUserRole) {
            return ['Hauptadmin', 'Admin'].includes(role);
        }

        async function isAccountBlocked(email) {
            if (!email || isMainAdminEmail(email)) return false;
            const cleanMail = email.toLowerCase().trim();
            if (db) {
                try {
                    const snapshot = await db.collection('customers').get();
                    let blocked = false;
                    snapshot.forEach(doc => {
                        const d = doc.data();
                        if (d.email && d.email.toLowerCase().trim() === cleanMail && d.isBlocked === true) {
                            blocked = true;
                        }
                    });
                    return blocked;
                } catch (e) {
                    console.warn("Fehler:", e);
                }
            }
            return false;
        }

        function isFirstCustomerInquiryOrder(order) {
            if (!order || !order.email) return false;
            if (order.isFirstInquiry === true) return true;
            const cleanMail = order.email.toLowerCase().trim();
            const customerOrders = adminOrders
                .filter(o => o.email && o.email.toLowerCase().trim() === cleanMail)
                .sort((a, b) => new Date(a.createdAt || 0) - new Date(b.createdAt || 0));

            if (customerOrders.length === 1) return true;
            if (customerOrders.length > 1 && customerOrders[0].id === order.id) return true;
            return false;
        }

        function isNewCustomerLockedForWork(order) {
            if (!order) return false;
            const isFirst = isFirstCustomerInquiryOrder(order);
            const isUnpaid = (!order.paymentStatus || order.paymentStatus === 'unpaid');
            const invoiceNotSent = !order.depositInvoiceSent;
            return isFirst && isUnpaid && invoiceNotSent;
        }

        async function checkAndAutoUpgradeStammkunde(email, additionalNewOrder = 0) {
            if (!db || !email) return 'Kunde';
            const cleanMail = email.toLowerCase().trim();
            if (isMainAdminEmail(cleanMail)) return 'Hauptadmin';
            if (cleanMail === DEMO_IDENTIFIER) return 'Admin';

            try {
                const ordersSnap = await db.collection('orders').where('email', '==', email.trim()).get();
                const totalCustomerOrders = ordersSnap.size + additionalNewOrder;
                const custSnap = await db.collection('customers').get();
                let targetDoc = null;
                custSnap.forEach(doc => {
                    const data = doc.data();
                    if (data.email && data.email.toLowerCase().trim() === cleanMail) {
                        targetDoc = { id: doc.id, ...data };
                    }
                });

                let currentRole = targetDoc && targetDoc.role ? targetDoc.role : 'Kunde';
                if (currentRole === 'Kunde' && totalCustomerOrders >= STAMMKUNDE_ORDER_THRESHOLD) {
                    currentRole = 'Stammkunde';
                    if (targetDoc) {
                        await db.collection('customers').doc(targetDoc.id).update({ role: 'Stammkunde' });
                    }
                }
                return currentRole;
            } catch (e) {
                return 'Kunde';
            }
        }

        async function fetchRoleForEmail(email) {
            if (!email) return 'Kunde';
            const cleanMail = email.toLowerCase().trim();
            if (isMainAdminEmail(cleanMail)) return 'Hauptadmin';
            if (db) {
                try {
                    const snap = await db.collection('customers').get();
                    let dbRole = null;
                    snap.forEach(doc => {
                        const d = doc.data();
                        if (d.email && d.email.toLowerCase().trim() === cleanMail && d.role) dbRole = d.role;
                    });
                    if (cleanMail === DEMO_IDENTIFIER) return dbRole || 'Admin';
                    return await checkAndAutoUpgradeStammkunde(email, 0);
                } catch (e) {}
            }
            return cleanMail === DEMO_IDENTIFIER ? 'Admin' : 'Kunde';
        }

        async function ensureCustomerRecord(email, firstName = '', lastName = '', forcedDefaultRole = null) {
            if (!db || !email) return;
            const cleanMail = email.toLowerCase().trim();
            const defaultRole = forcedDefaultRole || (isMainAdminEmail(cleanMail) ? 'Hauptadmin' : (cleanMail === DEMO_IDENTIFIER ? 'Admin' : 'Kunde'));

            try {
                const snapshot = await db.collection('customers').get();
                let existingDoc = null;
                snapshot.forEach(doc => {
                    const data = doc.data();
                    if (data.email && data.email.toLowerCase().trim() === cleanMail) existingDoc = { id: doc.id, ...data };
                });

                if (!existingDoc) {
                    await db.collection('customers').add({
                        email: email.trim(),
                        firstName: firstName || (isMainAdminEmail(cleanMail) ? 'System' : (cleanMail === DEMO_IDENTIFIER ? 'Demo' : '')),
                        lastName: lastName || (isMainAdminEmail(cleanMail) ? 'Hauptadmin' : (cleanMail === DEMO_IDENTIFIER ? 'Admin-Konto' : '')),
                        role: defaultRole,
                        isBlocked: false,
                        createdAt: new Date().toISOString()
                    });
                }
            } catch (e) {}
        }

        if (auth) {
            auth.onAuthStateChanged(async user => {
                if (!user && sessionStorage.getItem('shk_demo_session') === 'true') {
                    currentUser = { email: 'Demo', uid: 'demo_admin_uid', isDemo: true };
                    await ensureCustomerRecord('Demo', 'Demo', 'Admin-Konto', 'Admin');
                    currentUserRole = await fetchRoleForEmail('Demo');
                    isStammkundeActive = (currentUserRole === 'Stammkunde');
                    updateNavbarUI();
                    loadUserOrders();
                    if (hasAdminAccess()) {
                        await loadAdminOrders();
                        await loadMarketPrices();
                        await loadCustomers();
                    }
                    return;
                }

                if (user) {
                    if (await isAccountBlocked(user.email)) {
                        await auth.signOut();
                        currentUser = null;
                        updateNavbarUI();
                        switchView('landing');
                        alert('Ihr Konto wurde gesperrt.');
                        return;
                    }
                    currentUser = user;
                    await ensureCustomerRecord(user.email);
                    currentUserRole = await fetchRoleForEmail(user.email);
                    isStammkundeActive = (currentUserRole === 'Stammkunde');
                    updateNavbarUI();
                    loadUserOrders();
                    if (hasAdminAccess()) {
                        await loadAdminOrders();
                        await loadMarketPrices();
                        await loadCustomers();
                    }
                } else {
                    currentUser = null;
                    currentUserRole = 'Kunde';
                    isStammkundeActive = false;
                    updateNavbarUI();
                }
            });
        }

        function updateNavbarUI() {
            const authNav = document.getElementById('authNavArea');
            const userNav = document.getElementById('userNavArea');
            const adminBtn = document.getElementById('adminNavBtn');
            const emailSpan = document.getElementById('navUserEmail');
            const roleBadge = document.getElementById('navUserRoleBadge');
            const clientPortalBadge = document.getElementById('clientPortalRoleBadge');
            const adminHeaderBadge = document.getElementById('adminHeaderRoleBadge');
            const clearDbBtn = document.getElementById('btnClearEntireMarketDb');

            if (currentUser) {
                authNav.classList.add('hidden');
                userNav.classList.remove('hidden');
                userNav.classList.add('flex');
                emailSpan.textContent = currentUser.email;
                if (roleBadge) roleBadge.textContent = currentUserRole;
                if (clientPortalBadge) clientPortalBadge.textContent = `Rang: ${currentUserRole}`;
                if (adminHeaderBadge) adminHeaderBadge.textContent = `Rolle: ${currentUserRole}`;
                if (hasAdminAccess()) adminBtn.classList.remove('hidden');
                else adminBtn.classList.add('hidden');
                if (clearDbBtn) {
                    if (isMainAdminUser()) clearDbBtn.classList.remove('hidden');
                    else clearDbBtn.classList.add('hidden');
                }
            } else {
                authNav.classList.remove('hidden');
                userNav.classList.add('hidden');
                userNav.classList.remove('flex');
                if (clearDbBtn) clearDbBtn.classList.add('hidden');
            }
        }

        function updateStammkundenBannerUI() {
            const banner = document.getElementById('stammkundenBanner');
            if (!banner) return;
            if (isStammkundeActive) banner.classList.remove('hidden');
            else banner.classList.add('hidden');
        }

        async function checkEmailForStammkunde(email) {
            if (!email || !email.includes('@')) return;
            const role = await fetchRoleForEmail(email);
            isStammkundeActive = (role === 'Stammkunde');
            updateStammkundenBannerUI();
            updatePackageInputDisplay();
