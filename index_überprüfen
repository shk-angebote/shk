        // GAEB PARSER & IMPORT (Inklusive .x83 Zwischenspeicher & Kurztext-Fallback)
        let cachedX83PositionsMap = new Map();
        try {
            const saved = localStorage.getItem('shk_cached_x83_lv');
            if (saved) cachedX83PositionsMap = new Map(JSON.parse(saved));
        } catch(e) {}

        function saveX83CacheToStorage() {
            try { localStorage.setItem('shk_cached_x83_lv', JSON.stringify(Array.from(cachedX83PositionsMap.entries()))); } catch(e) {}
        }

        function normalizeOzKey(rawOz) {
            if (!rawOz) return '';
            return String(rawOz).trim().split(/[._\-\s/]+/).filter(Boolean).map(p => p.replace(/^0+(?=\d)/, '')).join('_');
        }

        function getFirstSentenceFromLongText(rawText) {
            if (!rawText) return '';
            const lines = String(rawText).split(/\r?\n|\|/).map(l => l.replace(/\s+/g, ' ').trim()).filter(l => l.length > 2 && !/^(pos\.|position|oz|menge|einheit)\b/i.test(l));
            if (lines.length === 0) return '';
            const match = lines[0].match(/^(.{6,}?[.!?])(?:\s+|$)/);
            return (match ? match[1] : lines[0]).substring(0, 120);
        }

        function parseGAEBXmlContent(xmlContent) {
            const cleanedXml = String(xmlContent || '').replace(/<(\/?)[a-zA-Z0-9_-]+:/g, '<$1').replace(/\s+xmlns(:[a-zA-Z0-9_-]+)?="[^"]*"/g, '');
            const parser = new DOMParser();
            let xmlDoc = parser.parseFromString(cleanedXml, "text/xml");
            if (xmlDoc.querySelector('parsererror')) xmlDoc = parser.parseFromString(cleanedXml, "text/html");

            const items = xmlDoc.querySelectorAll('Item, BoQItem, LstSatz');
            const parsedList = [];

            items.forEach((node, idx) => {
                const itemId = (node.getAttribute('ID') || node.getAttribute('id') || '').trim();
                const rNoPart = (node.getAttribute('RNoPart') || node.getAttribute('rnopart') || '').trim();
                const ctgyParts = [];
                let parent = node.parentElement;
                while (parent) {
                    if (parent.tagName && parent.tagName.toLowerCase() === 'boqctgy') {
                        const pRNo = (parent.getAttribute('RNoPart') || parent.getAttribute('rnopart') || '').trim();
                        if (pRNo) ctgyParts.unshift(pRNo);
                    }
                    parent = parent.parentElement;
                }
                if (rNoPart) ctgyParts.push(rNoPart);

                const normOz = normalizeOzKey(ctgyParts.join('_') || itemId || ('idx_' + idx));
                const longDesc = extractOptionalGAEBLongText(node);
                let shortTitle = extractStrictGAEBShortText(node);
                if (!shortTitle && longDesc) shortTitle = getFirstSentenceFromLongText(longDesc);

                const qtyNode = node.querySelector('Qty, Quantity, Menge');
                const qty = qtyNode ? parseFloat(qtyNode.textContent.trim().replace(',', '.')) || 1 : 1;
                const unitNode = node.querySelector('QU, Unit, ME');
                let rawUnit = unitNode && unitNode.textContent ? normalizeGAEBUnit(unitNode.textContent) : '';
                const priceNode = node.querySelector('UP, UnitPrice, Price, IT');
                let price = priceNode ? parseFloat(priceNode.textContent.trim().replace(',', '.')) || 0 : 0;

                if (shortTitle) {
                    const entry = { title: shortTitle, longText: longDesc, unit: rawUnit || 'Stk', qty: qty };
                    cachedX83PositionsMap.set('oz_' + normOz, entry);
                    if (itemId) cachedX83PositionsMap.set('id_' + itemId, entry);
                } else {
                    const cached = cachedX83PositionsMap.get('oz_' + normOz) || (itemId ? cachedX83PositionsMap.get('id_' + itemId) : null);
                    if (cached) {
                        shortTitle = cached.title || '';
                        if (!longDesc) longDesc = cached.longText || '';
                        if (!rawUnit) rawUnit = cached.unit || 'Stk';
                    }
                }

                parsedList.push({ id: normOz, xmlId: itemId, ozKey: normOz, index: idx, title: shortTitle, longText: longDesc, qty: qty, unit: rawUnit, price: price });
            });
            if (cachedX83PositionsMap.size > 0) saveX83CacheToStorage();
            return parsedList;
        }

        function extractOptionalGAEBLongText(itemNode) {
            const nodes = itemNode.querySelectorAll('DetailTxt, CompleteTextDetail, LongText, TextComplement');
            if (!nodes.length) return '';
            let c = [];
            nodes.forEach(n => { const t = (n.textContent || '').replace(/\s+/g, ' ').trim(); if (t) c.push(t); });
            return c.join(' | ').substring(0, 600);
        }

        function extractStrictGAEBShortText(itemNode) {
            const shortNodes = itemNode.querySelectorAll('OutlineText OutlTxt TextOutlTxt, OutlineText TextOutlTxt, OutlTxt TextOutlTxt, OutlTxt, ShortDesc, Kurztext');
            for (const n of shortNodes) {
                if (n && n.textContent) { const t = n.textContent.replace(/\s+/g, ' ').trim(); if (t.length > 1) return t.substring(0, 120); }
            }
            const long = extractOptionalGAEBLongText(itemNode);
            if (long) return getFirstSentenceFromLongText(long);
            return '';
        }

        async function handleFileImport() {
            const files = Array.from(document.getElementById('importFile').files || []);
            const feedback = document.getElementById('importFeedback');
            if (files.length === 0) { alert("Bitte Datei auswählen."); return; }
            feedback.textContent = "Importiere und berechne Mittelwerte...";
            feedback.className = "text-xs block text-amber-400";
            try {
                if (db && marketPrices.length === 0) {
                    const snap = await db.collection('market_prices').get();
                    snap.forEach(doc => marketPrices.push({ idDoc: doc.id, ...doc.data() }));
                }
                const loaded = await Promise.all(files.map(file => {
                    const lower = file.name.toLowerCase();
                    const isBin = /\.(xlsx|xls)$/.test(lower);
                    return new Promise((res, rej) => {
                        const r = new FileReader();
                        r.onload = e => res({ name: lower, isBin, data: e.target.result });
                        r.onerror = rej;
                        if (isBin) r.readAsArrayBuffer(file);
                        else r.readAsText(file, "UTF-8");
                    });
                }));

                const merged = new Map();
                loaded.forEach(f => {
                    if (/\.xlsx|\.xls/.test(f.name)) {
                        const wb = XLSX.read(f.data, { type: 'array' });
                        parseTabularRows(XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { header: 1, defval: '' })).forEach(it => {
                            merged.set(normalizePositionTitleKey(it.title), { title: it.title, longText: it.longText, unit: it.unit, category: it.category, prices: it.prices });
                        });
                    } else if (/\.pdf$/.test(f.name)) {
                        extractOfferPositionsFromPDF(f.data).then(pdfItems => {
                            pdfItems.forEach(it => {
                                merged.set(normalizePositionTitleKey(it.title), { title: it.title, longText: '', unit: it.unit, category: detectSHKCategory(it.title), prices: [it.offeredUnitPrice] });
                            });
                        });
                    } else {
                        parseGAEBXmlContent(f.data).forEach(it => {
                            if (it.title && it.price > 0) {
                                merged.set(normalizePositionTitleKey(it.title), { title: it.title, longText: it.longText, unit: it.unit || 'Stk', category: detectSHKCategory(it.title), prices: [it.price] });
                            }
                        });
                    }
                });

                setTimeout(async () => {
                    const lookup = new Map();
                    marketPrices.forEach(mp => { const k = normalizePositionTitleKey(mp.title); if (k) lookup.set(k, mp); });

                    if (db) {
                        const batch = db.batch();
                        merged.forEach((imp, key) => {
                            const exist = lookup.get(key);
                            if (exist && exist.idDoc) {
                                const oldP = (exist.prices || []).filter(p => p > 0);
                                const comb = [...oldP, ...imp.prices];
                                const avg = Number((comb.reduce((a,b)=>a+b,0)/comb.length).toFixed(2));
                                batch.update(db.collection('market_prices').doc(exist.idDoc), { prices: comb, average: avg, unit: imp.unit || exist.unit });
                            } else {
                                const avg = Number((imp.prices.reduce((a,b)=>a+b,0)/imp.prices.length).toFixed(2));
                                batch.set(db.collection('market_prices').doc(), { title: imp.title, longText: imp.longText, unit: imp.unit || 'Stk', category: imp.category, prices: imp.prices, average: avg, updatedAt: new Date().toISOString() });
                            }
                        });
                        await batch.commit();
                    }
                    feedback.textContent = "✓ Import erfolgreich!";
                    feedback.className = "text-xs block text-emerald-400 font-semibold";
                    loadMarketPrices();
                }, 300);
            } catch (err) {
                feedback.textContent = "⚠ " + err.message;
                feedback.className = "text-xs block text-rose-400 font-semibold";
            }
        }

