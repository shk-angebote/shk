        function updatePortalOrderPricePreview() {
            const selectVal = document.getElementById('portalPackageSelect').value || 'Heizungs-Angebot|149';
            const [_, priceStr] = selectVal.split('|');
            const basePrice = parseFloat(priceStr) || 149;
            const code = (document.getElementById('portalDiscountInput').value || '').trim().toUpperCase();
