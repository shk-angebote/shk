    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyB_hKknTz9_FM__bneuGv6IKaw_0sbKhIM",
            authDomain: "shk-angebote-pruefen.firebaseapp.com",
            databaseURL: "https://shk-angebote-pruefen-default-rtdb.firebaseio.com",
            projectId: "shk-angebote-pruefen",
            storageBucket: "shk-angebote-pruefen.firebasestorage.app",
            messagingSenderId: "161020111334",
            appId: "1:161020111334:web:81bfc26839a41490220e27",
            measurementId: "G-1ZPEMKMHWS"
        };

        let db, auth;
        try {
            if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
            auth = firebase.auth();
            db = firebase.firestore();
        } catch (e) { console.warn(e); }

        let currentUser = null;
        let userOrders = [];
        let activeOrderId = null;
        let adminOrders = [];
        let marketPrices = [];
        let customersList = [];
        let selectedAdminOrderId = null;
        let currentAdminTab = 'active'; 

        const ADMIN_EMAIL = "admin@shk-angebote-pruefen.web.app";

        if (auth) {
            auth.onAuthStateChanged(user => {
                currentUser = user;
                updateNavbarUI();
                if (user) {
                    loadUserOrders();
                    if (user.email === ADMIN_EMAIL) {
                        loadAdminOrders();
                        loadMarketPrices();
                        loadCustomers();
                    }
                }
            });
        }

        function updateNavbarUI() {
            const authNav = document.getElementById('authNavArea');
            const userNav = document.getElementById('userNavArea');
            const adminBtn = document.getElementById('adminNavBtn');
            const emailSpan = document.getElementById('navUserEmail');

            if (currentUser) {
                authNav.classList.add('hidden');
                userNav.classList.remove('hidden');
                emailSpan.textContent = currentUser.email;
                if (currentUser.email === ADMIN_EMAIL) adminBtn.classList.remove('hidden');
                else adminBtn.classList.add('hidden');
            } else {
                authNav.classList.remove('hidden');
                userNav.classList.add('hidden');
            }
        }

        function switchView(viewName) {
            document.getElementById('landingView').classList.add('hidden');
            document.getElementById('clientPortalView').classList.add('hidden');
            document.getElementById('adminPortalView').classList.add('hidden');

            if (viewName === 'landing') {
                document.getElementById('landingView').classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else if (viewName === 'clientPortal') {
                if (!currentUser) { openAuthModal(); return; }
                document.getElementById('clientPortalView').classList.remove('hidden');
                loadUserOrders();
            } else if (viewName === 'adminPortal') {
                if (!currentUser || currentUser.email !== ADMIN_EMAIL) { alert('Nur für Administratoren.'); return; }
                document.getElementById('adminPortalView').classList.remove('hidden');
                loadAdminOrders();
                loadMarketPrices();
                loadCustomers();
            }
        }

        function openClientPortal() { switchView('clientPortal'); }
        function openAdminPortal() { switchView('adminPortal'); }

        function selectPackage(name, price) {
            document.getElementById('selectedPackageInput').value = `${name} (${price} €)`;
            document.getElementById('rechner').scrollIntoView({ behavior: 'smooth' });
        }

        function applyDiscountCode() {
            const code = document.getElementById('discountCodeInput').value.trim().toUpperCase();
            const feedback = document.getElementById('discountFeedback');
            if (code === 'ANGEBOT10') {
                feedback.textContent = "10% Rabatt angewendet!";
                feedback.className = "text-xs mt-1 block text-emerald-400 font-semibold";
            } else {
                feedback.textContent = "Ungültiger Code.";
                feedback.className = "text-xs mt-1 block text-rose-400";
            }
        }

        function handleFileSelect(e) {
            if (e.target.files[0]) document.getElementById('fileNameDisplay').textContent = `Ausgewählt: ${e.target.files[0].name}`;
        }

        async function handleOrderSubmission(e) {
            e.preventDefault();
            const email = document.getElementById('orderEmail').value.trim();
            const firstName = document.getElementById('orderFirstName').value.trim();
            const lastName = document.getElementById('orderLastName').value.trim();
            const projectName = document.getElementById('orderProjectName').value.trim() || 'Standard Projekt';
            const password = document.getElementById('orderPasswordInput').value;
            const file = document.getElementById('offerFile').files[0];

            if (!file) return alert("Bitte Angebotsdatei wählen.");

            try {
                const methods = await auth.fetchSignInMethodsForEmail(email);
                const isExistingUser = methods.length > 0;

                if (!isExistingUser) {
                    if (!firstName || !lastName || !password || password.length < 6) {
                        return alert("Neukunden müssen Vorname, Nachname und ein Passwort (min. 6 Zeichen) angeben.");
                    }
                    await auth.createUserWithEmailAndPassword(email, password);
                } else if (password) {
                    try { await auth.signInWithEmailAndPassword(email, password); } catch(err) {}
                }

                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = async function () {
                    const newOrder = {
                        id: 'SHK-' + Math.floor(100000 + Math.random() * 900000),
                        packageName: 'Heizungs-Angebot',
                        price: 149,
                        email: email,
                        firstName: firstName || '',
                        lastName: lastName || '',
                        projectName: projectName,
                        fileName: file.name,
                        fileData: reader.result,
                        status: 1,
                        paymentStatus: 'unpaid',
                        isArchived: false,
                        createdAt: new Date().toISOString(),
                        userId: auth.currentUser ? auth.currentUser.uid : 'anon'
                    };

                    if (db) {
                        await db.collection('orders').add(newOrder);
                        if (!isExistingUser) {
                            await db.collection('customers').add({
                                email: email,
                                firstName: firstName,
                                lastName: lastName,
                                rank: 'Zuverlässiger Kunde',
                                createdAt: new Date().toISOString()
                            });
                        }
                    }
                    alert('Auftrag erfolgreich eingereicht!');
                    switchView('clientPortal');
                };
            } catch (err) { alert("Fehler: " + err.message); }
        }

        async function handlePortalOrderSubmission(e) {
            e.preventDefault();
            if (!currentUser) return;
            const file = document.getElementById('portalOfferFile').files[0];
            const projectName = document.getElementById('portalProjectSelect').value || document.getElementById('portalNewProjectInput').value || 'Projekt';
            if (!file) return alert("Bitte Datei wählen.");

            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = async function() {
                const newOrder = {
                    id: 'SHK-' + Math.floor(100000 + Math.random() * 900000),
                    packageName: 'Heizungs-Angebot',
                    price: 149,
                    email: currentUser.email,
                    projectName: projectName,
                    fileName: file.name,
                    fileData: reader.result,
                    status: 1,
                    paymentStatus: 'unpaid',
                    isArchived: false,
                    createdAt: new Date().toISOString(),
                    userId: currentUser.uid
                };
                if (db) {
                    await db.collection('orders').add(newOrder);
                    alert("Hochgeladen zu " + projectName);
                    loadUserOrders();
                }
            };
        }

        function checkNewProjectInput(el) {
            const container = document.getElementById('newProjectNameContainer');
            if (el.value === "") container.classList.remove('hidden');
            else container.classList.add('hidden');
        }

        async function loadUserOrders() {
            userOrders = [];
            if (db && currentUser) {
                const snap = await db.collection('orders').where('email', '==', currentUser.email).get();
                snap.forEach(doc => userOrders.push({ idDoc: doc.id, ...doc.data() }));
            }
            document.getElementById('clientStatTotal').textContent = userOrders.length;
            document.getElementById('clientOrdersList').innerHTML = userOrders.map(o => `
                <div onclick="activeOrderId='${o.id}'; renderClientOrdersList();" class="bg-slate-900 border border-slate-800 rounded-xl p-4 cursor-pointer mb-2">
                    <span class="text-xs font-bold text-emerald-400">${o.id}</span>
                    <h4 class="text-white font-semibold text-sm">${o.projectName || 'Projekt'} (${o.price} €)</h4>
                </div>
            `).join('');
            
            const select = document.getElementById('portalProjectSelect');
            if (select) {
                const projs = [...new Set(userOrders.map(o => o.projectName || 'Standard Projekt'))];
                select.innerHTML = `<option value="">-- Neues Bauvorhaben anlegen --</option>` + projs.map(p => `<option value="${p}">${p}</option>`).join('');
            }
        }

        async function loadAdminOrders() {
            adminOrders = [];
            if (db) {
                const snap = await db.collection('orders').get();
                snap.forEach(doc => adminOrders.push({ idDoc: doc.id, ...doc.data() }));
            }
            renderAdminDashboard();
        }

        async function loadMarketPrices() {
            marketPrices = [];
            if (db) {
                const snap = await db.collection('market_prices').get();
                snap.forEach(doc => marketPrices.push({ idDoc: doc.id, ...doc.data() }));
            }
            if (currentAdminTab === 'marketprices') renderMarketPricesTable();
        }

        async function loadCustomers() {
            customersList = [];
            if (db) {
                const snap = await db.collection('customers').get();
                snap.forEach(doc => customersList.push({ idDoc: doc.id, ...doc.data() }));
            }
            if (currentAdminTab === 'customers') renderCustomersTable();
        }

        // Kunden-Rang in Firestore aktualisieren
        async function updateCustomerRank(email, newRank) {
            if (!db) return;
            try {
                const snap = await db.collection('customers').where('email', '==', email).get();
                if (!snap.empty) {
                    await db.collection('customers').doc(snap.docs[0].id).update({ rank: newRank });
                } else {
                    // Falls Kunde noch nicht in 'customers' Sammlung existiert, anlegen
                    await db.collection('customers').add({ email: email, rank: newRank, createdAt: new Date().toISOString() });
                }
                alert(`Rang für ${email} auf "${newRank}" aktualisiert!`);
                loadCustomers();
            } catch (err) { alert("Fehler: " + err.message); }
        }

        function renderCustomersTable() {
            const container = document.getElementById('adminCustomersTableContainer');
            if (!container) return;

            const ranks = ['Zuverlässiger Kunde', 'Stammkunde', 'Sachbearbeiter', 'Admin'];
            const custMap = {};

            // Aus Kundensammlung laden oder aus Aufträgen ermitteln
            customersList.forEach(c => { custMap[c.email.toLowerCase()] = c; });
            adminOrders.forEach(o => {
                if (o.email && !custMap[o.email.toLowerCase()]) {
                    custMap[o.email.toLowerCase()] = { email: o.email, firstName: o.firstName || '-', lastName: o.lastName || '-', rank: 'Zuverlässiger Kunde' };
                }
            });

            const arr = Object.values(custMap);
            if (arr.length === 0) { container.innerHTML = `<p class="text-xs text-slate-500 py-4 text-center">Keine Kunden.</p>`; return; }

            container.innerHTML = `
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-950 text-slate-400 uppercase border-b border-slate-800">
                        <tr>
                            <th class="p-3">Name</th>
                            <th class="p-3">E-Mail</th>
                            <th class="p-3">Accountsrand zuweisen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        ${arr.map(c => `
                            <tr class="hover:bg-slate-950/50">
                                <td class="p-3 font-semibold text-white">${c.firstName || '-'} ${c.lastName || ''}</td>
                                <td class="p-3 text-emerald-400">${c.email}</td>
                                <td class="p-3">
                                    <select onchange="updateCustomerRank('${c.email}', this.value)" class="bg-slate-950 border border-slate-700 text-white rounded-lg px-2 py-1 focus:outline-none">
                                        ${ranks.map(r => `<option value="${r}" ${c.rank === r ? 'selected' : ''}>${r}</option>`).join('')}
                                    </select>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            `;
        }

        function switchAdminTab(tabName) {
            currentAdminTab = tabName;
            ['active', 'rejected', 'cancelled', 'archive', 'customers', 'marketprices'].forEach(t => {
                const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                if (btn) btn.className = "px-5 py-3 text-sm font-bold border-b-2 " + (t === tabName ? "border-emerald-500 text-emerald-400" : "border-transparent text-slate-400");
            });

            document.getElementById('adminSelectPrompt').classList.add('hidden');
            document.getElementById('adminEditorPanel').classList.add('hidden');
            document.getElementById('adminMarketPricesPanel').classList.add('hidden');
            document.getElementById('adminCustomersPanel').classList.add('hidden');

            if (tabName === 'marketprices') document.getElementById('adminMarketPricesPanel').classList.remove('hidden');
            else if (tabName === 'customers') { document.getElementById('adminCustomersPanel').classList.remove('hidden'); loadCustomers(); }
            else document.getElementById('adminSelectPrompt').classList.remove('hidden');

            renderAdminDashboard();
        }

        function renderAdminDashboard() {
            const container = document.getElementById('adminOrdersList');
            if (currentAdminTab === 'active' || currentAdminTab === 'rejected' || currentAdminTab === 'cancelled' || currentAdminTab === 'archive') {
                let filtered = adminOrders;
                if (currentAdminTab === 'active') filtered = adminOrders.filter(o => !o.isArchived && o.status != 5 && o.status != 6);
                if (currentAdminTab === 'rejected') filtered = adminOrders.filter(o => !o.isArchived && o.status == 5);
                if (currentAdminTab === 'cancelled') filtered = adminOrders.filter(o => !o.isArchived && o.status == 6);
                if (currentAdminTab === 'archive') filtered = adminOrders.filter(o => o.isArchived);

                container.innerHTML = filtered.length === 0 ? `<p class="text-xs text-slate-500">Keine Aufträge.</p>` : filtered.map(o => `
                    <div onclick="selectedAdminOrderId='${o.id}'; document.getElementById('adminSelectPrompt').classList.add('hidden'); document.getElementById('adminEditorPanel').classList.remove('hidden'); document.getElementById('adminEditOrderId').textContent='Auftrag '+o.id+' ['+(o.projectName||'')+']'; document.getElementById('adminEditCustomerEmail').textContent=o.email;" class="bg-slate-900 border border-slate-800 rounded-xl p-4 cursor-pointer mb-2">
                        <span class="text-xs font-bold text-amber-400">${o.id}</span>
                        <h4 class="text-white font-semibold text-sm">${o.projectName || 'Projekt'}</h4>
                        <p class="text-xs text-slate-400">${o.email}</p>
                    </div>
                `).join('');
            }
        }

        function saveMarketPriceItem(e) {
            e.preventDefault();
            const title = document.getElementById('mpTitle').value;
            const p1 = parseFloat(document.getElementById('mpPrice1').value) || 0;
            const p2 = parseFloat(document.getElementById('mpPrice2').value) || 0;
            const p3 = parseFloat(document.getElementById('mpPrice3').value) || 0;
            if (db) {
                db.collection('market_prices').add({ title, prices: [p1,p2,p3], average: (p1+p2+p3)/3, updatedAt: new Date().toISOString() })
                  .then(() => { alert("Marktpreis gespeichert!"); loadMarketPrices(); });
            }
        }

        function renderMarketPricesTable() {
            document.getElementById('marketPricesTableContainer').innerHTML = `
                <table class="w-full text-left text-xs text-slate-300">
                    <tr class="bg-slate-950 text-slate-400"><th class="p-2">Position</th><th class="p-2">Mittelwert</th></tr>
                    ${marketPrices.map(m => `<tr class="border-b border-slate-800"><td class="p-2">${m.title}</td><td class="p-2 text-emerald-400">${m.average.toFixed(2)} €</td></tr>`).join('')}
                </table>`;
        }

        function openAuthModal() { document.getElementById('authModal').classList.remove('hidden'); }
        function closeAuthModal() { document.getElementById('authModal').classList.add('hidden'); }
        async function handleAuthSubmit(e) {
            e.preventDefault();
            try {
                await auth.signInWithEmailAndPassword(document.getElementById('authEmail').value, document.getElementById('authPassword').value);
                closeAuthModal(); openClientPortal();
            } catch(err) { alert(err.message); }
        }
        async function logoutUser() {
            if (auth) await auth.signOut();
            currentUser = null; updateNavbarUI(); switchView('landing');
        }
    </script>
</body>
</html>
