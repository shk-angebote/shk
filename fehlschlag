<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHK Angebotsprüfung | Technische & Kaufmännische Analyse</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        slate: { 850: '#1e293b', 900: '#0f172a' },
                        emerald: { 500: '#10b981', 600: '#059669' }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased selection:bg-emerald-500 selection:text-white">

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchView('landing')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-emerald-500/20">
                    <i class="fa-solid fa-wrench"></i>
                </div>
                <div>
                    <span class="text-xl font-bold tracking-tight text-white">SHK<span class="text-emerald-400">Prüfung</span></span>
                    <span class="block text-xs text-slate-400 font-medium">Technischer & Kaufmännischer Check</span>
                </div>
            </div>
            
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
                <a href="#vorteile" class="hover:text-emerald-400 transition">Vorteile</a>
                <a href="#ablauf" class="hover:text-emerald-400 transition">Ablauf</a>
                <a href="#preise" class="hover:text-emerald-400 transition">Pakete</a>
                <a href="#faq" class="hover:text-emerald-400 transition">FAQ</a>
            </nav>

            <div class="flex items-center space-x-4">
                <div id="authNavArea">
                    <button type="button" onclick="openAuthModal('login')" class="px-4 py-2 text-sm font-medium text-slate-300 hover:text-white transition">Login</button>
                    <button type="button" onclick="openAuthModal('register')" class="bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold px-4 py-2 rounded-xl text-sm shadow-lg shadow-emerald-500/20 transition">Kundenportal</button>
                </div>
                <div id="userNavArea" class="hidden items-center space-x-3">
                    <span id="navUserEmail" class="text-xs text-slate-400 hidden sm:inline"></span>
                    <button type="button" onclick="openClientPortal()" class="bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-emerald-500/30 px-4 py-2 rounded-xl text-sm font-medium transition">
                        <i class="fa-solid fa-gauge-high mr-2"></i>Dashboard
                    </button>
                    <button type="button" id="adminNavBtn" onclick="openAdminPortal()" class="hidden bg-amber-500 hover:bg-amber-600 text-slate-950 px-3 py-2 rounded-xl text-sm font-bold transition">
                        <i class="fa-solid fa-shield-halved mr-1"></i>Admin
                    </button>
                    <button type="button" onclick="logoutUser()" class="text-slate-400 hover:text-red-400 p-2 transition" title="Abmelden">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container Views -->
    <main id="appContainer">
        <!-- LANDING VIEW -->
        <div id="landingView">
            <!-- Hero Section -->
            <section class="relative pt-20 pb-24 overflow-hidden">
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-900/20 via-slate-900 to-slate-900 -z-10"></div>
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                    <div class="inline-flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/20 px-3.5 py-1.5 rounded-full text-emerald-400 text-xs font-semibold mb-6">
                        <i class="fa-solid fa-shield-check"></i>
                        <span>Unabhängige Handwerker-Angebotsprüfung vom Meister</span>
                    </div>
                    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-tight">
                        Schützen Sie sich vor <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">teuren Fehlern & Nachtragsfallen</span> im SHK-Bereich.
                    </h1>
                    <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto">
                        Bevor Sie tausende Euro für Heizungsmodernisierung oder Badsanierung unterschreiben: Lassen Sie Ihr Angebot neutral auf technische Plausibilität und faire Preise prüfen.
                    </p>
                    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
                        <a href="#rechner" class="bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold px-8 py-4 rounded-xl text-lg shadow-xl shadow-emerald-500/20 transition text-center">
                            Jetzt Angebot prüfen lassen <i class="fa-solid fa-arrow-right ml-2"></i>
                        </a>
                        <button type="button" onclick="openAuthModal('register')" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold px-8 py-4 rounded-xl text-lg border border-slate-700 transition">
                            Zum Kundenportal
                        </button>
                    </div>

                    <!-- Trust Indicators -->
                    <div id="vorteile" class="mt-16 pt-12 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-6 text-left max-w-5xl mx-auto">
                        <div class="flex items-start space-x-3">
                            <div class="text-emerald-400 text-xl"><i class="fa-solid fa-circle-check"></i></div>
                            <div>
                                <h4 class="text-white font-semibold text-sm">100% Unabhängig</h4>
                                <p class="text-slate-400 text-xs mt-0.5">Keine Provisionen, rein sachlich.</p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-3">
                            <div class="text-emerald-400 text-xl"><i class="fa-solid fa-user-gear"></i></div>
                            <div>
                                <h4 class="text-white font-semibold text-sm">Meister-Kompetenz</h4>
                                <p class="text-slate-400 text-xs mt-0.5">Geprüft durch erfahrene TGA-Praxis.</p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-3">
                            <div class="text-emerald-400 text-xl"><i class="fa-solid fa-bolt"></i></div>
                            <div>
                                <h4 class="text-white font-semibold text-sm">Schnelle Analyse</h4>
                                <p class="text-slate-400 text-xs mt-0.5">Ergebnis meist innerhalb von 48h.</p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-3">
                            <div class="text-emerald-400 text-xl"><i class="fa-solid fa-file-shield"></i></div>
                            <div>
                                <h4 class="text-white font-semibold text-sm">Datenschutz</h4>
                                <p class="text-slate-400 text-xs mt-0.5">Sichere Cloud & DSGVO-konform.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Pricing & Interactive Calculator Section -->
            <section id="preise" class="py-20 bg-slate-950/50 border-y border-slate-800/60">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center max-w-3xl mx-auto mb-16">
                        <h2 class="text-3xl font-bold text-white">Transparente Pakete & Auftrags-Upload</h2>
                        <p class="text-slate-400 mt-3">Wählen Sie Ihr Gewerk und laden Sie Ihr Angebot direkt hoch, um den Prüfprozess zu starten.</p>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                        <!-- Package Cards -->
                        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-xl flex flex-col justify-between">
                            <div>
                                <span class="text-emerald-400 font-semibold text-xs uppercase tracking-wider">Basis Check</span>
                                <h3 class="text-2xl font-bold text-white mt-2">Heizungs-Angebot</h3>
                                <div class="mt-4 flex items-baseline">
                                    <span class="text-4xl font-extrabold text-white">149 €</span>
                                    <span class="text-slate-400 ml-2 text-sm">inkl. MwSt.</span>
                                </div>
                                <p class="text-slate-400 text-sm mt-4">Ideal für den schnellen Plausibilitätscheck von Wärmepumpen- oder Heizungsangeboten.</p>
                                <ul class="mt-6 space-y-3 text-sm text-slate-300">
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Plausibilitätsprüfung der angebotenen Heizleistung anhand der vorliegenden Unterlagen</li>
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Einheitspreis-Check (Material & Montage)</li>
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Schriftlicher Prüfbericht als PDF</li>
                                </ul>
                            </div>
                            <button type="button" onclick="selectPackage('Heizungs-Angebot', 149)" class="mt-8 w-full bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-white font-semibold py-3 rounded-xl transition">Paket wählen</button>
                        </div>

                        <div class="bg-slate-900 border-2 border-emerald-500 rounded-2xl p-8 shadow-2xl relative flex flex-col justify-between">
                            <div class="absolute -top-3.5 left-1/2 transform -translate-x-1/2 bg-emerald-500 text-slate-950 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">Beliebt</div>
                            <div>
                                <span class="text-emerald-400 font-semibold text-xs uppercase tracking-wider">Premium Check</span>
                                <h3 class="text-2xl font-bold text-white mt-2">Komplettbad / Sanitär</h3>
                                <div class="mt-4 flex items-baseline">
                                    <span class="text-4xl font-extrabold text-white">249 €</span>
                                    <span class="text-slate-400 ml-2 text-sm">inkl. MwSt.</span>
                                </div>
                                <p class="text-slate-400 text-sm mt-4">Tiefenprüfung für Badsanierungen inklusive Schnittstellen & Nebenleistungen.</p>
                                <ul class="mt-6 space-y-3 text-sm text-slate-300">
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Vollständigkeitsprüfung Gewerke</li>
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Identifikation erkennbarer Lücken und möglicher Nachtragsrisiken</li>
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Detaillierter Maßnahmen- & Einsparkatalog</li>
                                </ul>
                            </div>
                            <button type="button" onclick="selectPackage('Komplettbad / Sanitär', 249)" class="mt-8 w-full bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold py-3 rounded-xl transition shadow-lg shadow-emerald-500/20">Paket wählen</button>
                        </div>

                        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-xl flex flex-col justify-between">
                            <div>
                                <span class="text-emerald-400 font-semibold text-xs uppercase tracking-wider">Multi-Angebot</span>
                                <h3 class="text-2xl font-bold text-white mt-2">Angebotsvergleich</h3>
                                <div class="mt-4 flex items-baseline">
                                    <span class="text-4xl font-extrabold text-white">349 €</span>
                                    <span class="text-slate-400 ml-2 text-sm">inkl. MwSt.</span>
                                </div>
                                <p class="text-slate-400 text-sm mt-4">Gegenüberstellung von bis zu 3 konkurrierenden Installteursangeboten.</p>
                                <ul class="mt-6 space-y-3 text-sm text-slate-300">
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Direkter Leistungs- & Preisvergleich</li>
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Auswertung technischer Differenzen</li>
                                    <li class="flex items-center"><i class="fa-solid fa-check text-emerald-400 mr-3"></i>Vergabeempfehlung mit Begründung (unter Angabe von Grenzen und Voraussetzungen)</li>
                                </ul>
                            </div>
                            <button type="button" onclick="selectPackage('Angebotsvergleich', 349)" class="mt-8 w-full bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-white font-semibold py-3 rounded-xl transition">Paket wählen</button>
                        </div>
                    </div>

                    <!-- Upload & Inquiry Box -->
                    <div id="rechner" class="mt-16 bg-slate-900 border border-slate-800 rounded-2xl p-8 max-w-3xl mx-auto shadow-2xl">
                        <h3 class="text-xl font-bold text-white mb-2"><i class="fa-solid fa-cloud-arrow-up text-emerald-400 mr-2"></i>Auftrag einreichen</h3>
                        <p class="text-slate-400 text-sm mb-6">Füllen Sie die Eckdaten aus und laden Sie Ihr Angebot (PDF oder Bilder) hoch. Nach dem Absenden wird automatisch Ihr Kundenkonto erstellt bzw. verknüpft.</p>
                        
                        <form id="orderForm" onsubmit="handleOrderSubmission(event)" class="space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Gewähltes Paket</label>
                                    <input type="text" id="selectedPackageInput" readonly class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-emerald-400 font-semibold focus:outline-none" value="Heizungs-Angebot (149 €)">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">E-Mail-Adresse</label>
                                    <input type="email" id="orderEmail" required placeholder="name@beispiel.de" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:border-emerald-500 focus:outline-none">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Vorname (nur bei Neukunden)</label>
                                    <input type="text" id="orderFirstName" placeholder="Max" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:border-emerald-500 focus:outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Nachname (nur bei Neukunden)</label>
                                    <input type="text" id="orderLastName" placeholder="Mustermann" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:border-emerald-500 focus:outline-none">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Bauvorhaben / Projekt (Oberordner)</label>
                                <input type="text" id="orderProjectName" placeholder="z. B. EFH Hauptstraße 12" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:border-emerald-500 focus:outline-none" value="Standard Projekt">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Passwort (nur bei Neukunden Pflicht)</label>
                                <input type="password" id="orderPasswordInput" placeholder="Min. 6 Zeichen für Neukunden-Konto" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:border-emerald-500 focus:outline-none">
                                <span class="text-[11px] text-slate-400 mt-1 block">Bestandskunden können das Passwort leer lassen.</span>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Rabattcode (optional)</label>
                                <div class="flex gap-2">
                                    <input type="text" id="discountCodeInput" placeholder="z. B. Angebot10" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:border-emerald-500 focus:outline-none uppercase">
                                    <button type="button" onclick="applyDiscountCode()" class="bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-emerald-500/30 font-semibold px-4 py-2.5 rounded-xl text-xs transition whitespace-nowrap">Code anwenden</button>
                                </div>
                                <span id="discountFeedback" class="text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Angebotsdatei (PDF, JPG, PNG)</label>
                                <div class="border-2 border-dashed border-slate-700 hover:border-emerald-500 rounded-xl p-6 text-center cursor-pointer transition bg-slate-950/50">
                                    <input type="file" id="offerFile" class="hidden" onchange="handleFileSelect(event)">
                                    <label for="offerFile" class="cursor-pointer">
                                        <i class="fa-solid fa-file-arrow-up text-3xl text-emerald-400 mb-2"></i>
                                        <p id="fileNameDisplay" class="text-sm text-slate-300 font-medium">Klicken zum Hochladen oder Datei hierher ziehen</p>
                                        <span class="text-xs text-slate-500 mt-1 block">Max. Dateigröße 25 MB</span>
                                    </label>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Zusätzliche Hinweise / Fragen an den Prüfer</label>
                                <textarea id="orderNotes" rows="3" placeholder="z. B. Unser Haus ist von 1995..." class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:border-emerald-500 focus:outline-none"></textarea>
                            </div>
                            <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold py-4 rounded-xl text-base shadow-lg shadow-emerald-500/20 transition">
                                <i class="fa-solid fa-paper-plane mr-2"></i>Verbindlich anfragen & Kundenportal öffnen
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            <!-- FAQ Section -->
            <section id="faq" class="py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-3xl font-bold text-white text-center mb-12">Häufig gestellte Fragen (FAQ)</h2>
                <div class="space-y-4">
                    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
                        <h4 class="text-white font-semibold mb-2">Welche Angebote können geprüft werden?</h4>
                        <p class="text-slate-400 text-sm">Heizungsanlagen (Wärmepumpen, Gas, Öl), Komplette Badsanierungen, Lüftungsanlagen.</p>
                    </div>
                </div>
            </section>
        </div>

        <!-- CLIENT PORTAL VIEW -->
        <div id="clientPortalView" class="hidden py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 pb-6 border-b border-slate-800 gap-4">
                <div>
                    <h1 class="text-3xl font-extrabold text-white">Mein Kundenportal</h1>
                    <p class="text-slate-400 text-sm mt-1">Übersicht Ihrer eingereichten Angebote und Bauvorhaben in Echtzeit.</p>
                </div>
                <button type="button" onclick="switchView('landing')" class="bg-slate-800 hover:bg-slate-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition">
                    <i class="fa-solid fa-plus mr-2"></i>Zur Startseite
                </button>
            </div>

            <!-- Direkt-Upload im Kundenportal für Bestandskunden -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl mb-8">
                <h3 class="text-lg font-bold text-white mb-2"><i class="fa-solid fa-file-circle-plus text-emerald-400 mr-2"></i>Weiteres Angebot direkt hochladen</h3>
                <form onsubmit="handlePortalOrderSubmission(event)" class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1">Gewähltes Paket</label>
                            <select id="portalPackageSelect" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-emerald-400 font-semibold focus:outline-none focus:border-emerald-500">
                                <option value="Heizungs-Angebot|149">Heizungs-Angebot (149 €)</option>
                                <option value="Komplettbad / Sanitär|249">Komplettbad / Sanitär (249 €)</option>
                                <option value="Angebotsvergleich|349">Angebotsvergleich (349 €)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1">Bauvorhaben / Projekt (Oberordner)</label>
                            <select id="portalProjectSelect" onchange="checkNewProjectInput(this)" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                                <option value="">-- Neues Bauvorhaben anlegen --</option>
                            </select>
                        </div>
                    </div>

                    <div id="newProjectNameContainer" class="hidden">
                        <label class="block text-xs font-medium text-slate-300 mb-1">Name des neuen Bauvorhabens</label>
                        <input type="text" id="portalNewProjectInput" placeholder="z. B. Sanierung Bad OG" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:border-emerald-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1">Angebotsdatei (PDF, JPG, PNG)</label>
                        <input type="file" id="portalOfferFile" required class="w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-500 file:text-slate-950 hover:file:bg-emerald-600 cursor-pointer bg-slate-950 rounded-xl border border-slate-700 p-2">
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1">Zusätzliche Hinweise / Fragen</label>
                        <textarea id="portalOrderNotes" rows="2" placeholder="Hinweise..." class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:border-emerald-500 focus:outline-none"></textarea>
                    </div>

                    <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold px-6 py-3 rounded-xl text-xs transition shadow-lg shadow-emerald-500/20">
                        <i class="fa-solid fa-cloud-arrow-up mr-1"></i>Aus dem Portal hochladen
                    </button>
                </form>
            </div>

            <!-- Kunden KPIs -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
                    <span class="text-xs text-slate-400 block">Anzahl der Angebote</span>
                    <span id="clientStatTotal" class="text-2xl font-bold text-white mt-1 block">0</span>
